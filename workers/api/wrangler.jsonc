// ced-api: the live backend (docs/ARCHITECTURE.md). Deployed only by .github/workflows/deploy.yml after CI passes
// (D-026, grant G-007). Address: https://ced-api.<account subdomain>.workers.dev (D-027).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ced-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "HubDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HubDO"] }],
  // The deployed version's id: the poll loop tags each accepted body with it, so a deploy re-parses every endpoint once
  // (a parser fix applies at once instead of waiting for the upstream body to change; src/poll.ts codeVersion).
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Every minute: poll the registered sources into the HubDO (src/poll.ts).
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    // The only browser origin allowed to read the API cross-site (the GitHub Pages app).
    "PAGES_ORIGIN": "https://jst28323-art.github.io",
    // The web app's address: /feed.json's home_page_url and the API index link to it.
    "APP_URL": "https://jst28323-art.github.io/current-events-dashboard/"
  },
  "observability": { "enabled": true }
}
