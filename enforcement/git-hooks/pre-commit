#!/usr/bin/env bash
# enforcement/git-hooks/pre-commit — refuses a commit that STAGES a high-confidence secret. The repo is public (D-002):
# anything pushed must be treated as permanently leaked, and deleting it later does not un-publish it.
# Patterns: enforcement/secret-patterns.txt, the ONE source shared with scripts/gate.mjs (which also scans every
# tracked file and the unpushed history). Scans staged additions only.
# False positive? Append `pragma: allowlist secret` to that line. Never bypass with --no-verify (CLAUDE.md).
# Adapted from the agent-protocol bundle's enforcement/ hooks.
#
# ENABLE (once per clone):  git config core.hooksPath enforcement/git-hooks
# SELF-TEST (hermetic):     bash enforcement/git-hooks/pre-commit --self-test
set -u
HERE="$(cd "$(dirname "$0")" && pwd)"
PATS="$HERE/../secret-patterns.txt"
if [ ! -f "$PATS" ]; then
  echo "pre-commit: REFUSED — $PATS is missing, so the secret scan cannot run (fail closed)." >&2
  exit 1
fi
secret_re() { tr -d '\r\n' < "$PATS"; }
# stdin -> prints offending lines; exit 0 if a secret IS found, 1 if clean.
scan() { grep -v 'pragma: allowlist secret' | grep -En -- "$(secret_re)"; }

if [ "${1:-}" = "--self-test" ]; then
  fails=0; ok(){ printf '  ok   %s\n' "$1"; }; bad(){ printf '  FAIL %s\n' "$1"; fails=$((fails+1)); }
  # Keys are assembled from pieces so this file never contains a literal secret shape.
  aws="AKIA""IOSFODNN7EXAMPLE"; ant="sk-ant-""api03-""$(printf 'Q%.0s' $(seq 1 24))"
  printf 'aws=%s\n' "$aws" | scan >/dev/null && ok "AWS-shaped key flagged" || bad "AWS-shaped key NOT flagged"
  printf 'key=%s\n' "$ant" | scan >/dev/null && ok "Anthropic-shaped key flagged" || bad "Anthropic-shaped key NOT flagged"
  printf 'aws=%s  # pragma: allowlist secret\n' "$aws" | scan >/dev/null && bad "allowlist ignored" || ok "allowlisted line passes"
  printf 'a normal config value = 42, discussing a token in prose\n' | scan >/dev/null && bad "clean wrongly flagged" || ok "clean prose passes"
  echo "----"
  [ "$fails" -eq 0 ] && { echo "pre-commit secret-scan self-test: PASS"; exit 0; }
  echo "pre-commit secret-scan self-test: FAIL ($fails)"; exit 1
fi

# Normal invocation: scan staged ADDITIONS only.
hits="$(git diff --cached --no-color --unified=0 -- | grep -E '^\+' | grep -Ev '^\+\+\+' | scan)"
if [ -n "$hits" ]; then
  echo "pre-commit: REFUSED — a staged change looks like it contains a secret:" >&2
  printf '%s\n' "$hits" >&2
  echo "Remove it from the change (keys belong in GitHub/Cloudflare secrets or a gitignored .env). If it is truly a" >&2
  echo "false positive, append 'pragma: allowlist secret' to that line." >&2
  exit 1
fi
exit 0
