#!/usr/bin/env bash
# enforcement/wiring/git-hooks/pre-push   [HOST: git client-side; dependency-free]
# =============================================================================
# SAFE-GUARDS client-side enforcement (no GitHub plan / no public repo needed).
# Refuses a FORCE (non-fast-forward) push to a protected branch and refuses
# DELETION of a protected branch. Normal fast-forward pushes are ALLOWED, so it
# does NOT change a direct-to-default-branch workflow (this is the "safe guards"
# level, not "require PR"). Bypassable with --no-verify by design: it is local
# friction, not a server guarantee -- pair it with branch-protection.ruleset.json
# (server-side) once the repo is public or on a paid plan (two-defense pattern).
#
# ENABLE (in a clone):  git config core.hooksPath enforcement/wiring/git-hooks
# SELF-TEST (hermetic): bash enforcement/wiring/git-hooks/pre-push --self-test
# ADAPT: set PROTECTED_BRANCHES to your default branch name(s).
# =============================================================================
set -u
PROTECTED="${PROTECTED_BRANCHES:-main master}"
ZERO='0000000000000000000000000000000000000000'

is_protected() { local b="$1" p; for p in $PROTECTED; do [ "$b" = "$p" ] && return 0; done; return 1; }

# Decide one ref update. Returns 1 (and prints reason) to REJECT, 0 to allow.
check_one() {
  local local_sha="$1" remote_ref="$2" remote_sha="$3" branch
  case "$remote_ref" in refs/heads/*) ;; *) return 0 ;; esac
  branch="${remote_ref#refs/heads/}"
  is_protected "$branch" || return 0
  if [ "$local_sha" = "$ZERO" ]; then
    echo "pre-push: REFUSED deletion of protected branch '$branch'." >&2
    return 1
  fi
  if [ "$remote_sha" != "$ZERO" ] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    echo "pre-push: REFUSED non-fast-forward (force) push to protected branch '$branch'." >&2
    echo "          rewriting protected history is blocked; use a normal push, or --no-verify to bypass." >&2
    return 1
  fi
  return 0
}

if [ "${1:-}" = "--self-test" ]; then
  tmp="$(mktemp -d 2>/dev/null || mktemp -d -t pphook)"; fails=0
  ok(){ printf '  ok   %s\n' "$1"; }; bad(){ printf '  FAIL %s\n' "$1"; fails=$((fails+1)); }
  git -C "$tmp" init -q
  git -C "$tmp" config user.email t@t; git -C "$tmp" config user.name t
  echo a > "$tmp/f"; git -C "$tmp" add f; git -C "$tmp" commit -qm A; A="$(git -C "$tmp" rev-parse HEAD)"
  echo b >> "$tmp/f"; git -C "$tmp" commit -qam B; B="$(git -C "$tmp" rev-parse HEAD)"
  ( cd "$tmp"
    check_one "$B" refs/heads/main "$A" 2>/dev/null && echo FF_OK     || echo FF_BAD
    check_one "$A" refs/heads/main "$B" 2>/dev/null && echo FORCE_BAD || echo FORCE_OK
    check_one "$ZERO" refs/heads/main "$B" 2>/dev/null && echo DEL_BAD || echo DEL_OK
    check_one "$A" refs/heads/feature "$B" 2>/dev/null && echo NP_OK  || echo NP_BAD
  ) > "$tmp/res" 2>/dev/null
  grep -q '^FF_OK$'    "$tmp/res" && ok "fast-forward push allowed"        || bad "fast-forward wrongly rejected"
  grep -q '^FORCE_OK$' "$tmp/res" && ok "force push rejected"              || bad "force push NOT rejected"
  grep -q '^DEL_OK$'   "$tmp/res" && ok "branch deletion rejected"         || bad "deletion NOT rejected"
  grep -q '^NP_OK$'    "$tmp/res" && ok "non-protected branch allowed"     || bad "non-protected wrongly rejected"
  rm -rf "$tmp"
  echo "----"
  [ "$fails" -eq 0 ] && { echo "pre-push self-test: PASS"; exit 0; }
  echo "pre-push self-test: FAIL ($fails)"; exit 1
fi

# Normal invocation: git feeds ref updates on stdin as
#   <local_ref> <local_sha> <remote_ref> <remote_sha>
rc=0
while read -r _lref local_sha remote_ref remote_sha; do
  [ -z "${remote_ref:-}" ] && continue
  check_one "$local_sha" "$remote_ref" "$remote_sha" || rc=1
done
exit $rc
