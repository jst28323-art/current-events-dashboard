{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jst28323-art/current-events-dashboard/packages/schema/event.schema.json",
  "title": "CED event v0.1",
  "description": "One normalized event (docs/EVENT_MODEL.md). Required = the Phase-1 minimum; everything else is optional until a feature needs it. Unknown top-level fields are rejected so a typo fails loudly.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "dedup_key", "object_key", "event_type", "status", "branch", "body", "features", "title", "official_text", "times", "sources", "revision", "provenance"],
  "$defs": {
    "utc": {
      "description": "UTC instant, normalized at ingest (docs/TRAPS.md: time zones lie). Always ends in Z.",
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,3})?Z$"
    },
    "key": {
      "description": "<namespace>:<id> (docs/EVENT_MODEL.md object keys)",
      "type": "string",
      "pattern": "^[a-z][a-z_]*:[^\\s#]+$",
      "maxLength": 300
    },
    "httpsUrl": { "type": "string", "pattern": "^https://[^\\s]+$", "maxLength": 2000 },
    "affiliation": { "enum": ["official-nonpartisan", "official-partisan", "executive-messaging", "independent", "third-party", "unofficial"] }
  },
  "properties": {
    "schema_version": { "const": "0.1" },
    "id": { "type": "string", "pattern": "^evt_[0-9a-f]{16}$" },
    "dedup_key": { "type": "string", "pattern": "^[a-z][a-z_]*:[^\\s#]+#[a-z][a-z_.]*$", "maxLength": 340 },
    "object_key": { "$ref": "#/$defs/key" },
    "thread_key": { "$ref": "#/$defs/key" },
    "alias_keys": { "type": "array", "items": { "$ref": "#/$defs/key" }, "uniqueItems": true },
    "event_type": {
      "anyOf": [
        {
          "enum": [
            "floor.convened", "floor.adjourned", "floor.recess", "floor.pro_forma", "floor.action", "floor.speaking",
            "vote.scheduled", "vote.opened", "vote.tally", "vote.result",
            "bill.introduced", "bill.action", "bill.passed_chamber", "bill.presented", "bill.signed", "bill.vetoed", "law.enacted",
            "nomination.received", "nomination.committee_action", "nomination.confirmed", "nomination.rejected", "nomination.withdrawn",
            "hearing.scheduled", "hearing.live", "hearing.ended",
            "live.started", "live.ended", "transcript.segment", "transcript.published",
            "schedule.item",
            "presidential_action.executive_order", "presidential_action.proclamation", "presidential_action.memorandum",
            "presidential_action.notice", "presidential_action.determination", "presidential_action.nominations_sent",
            "presidential_action.statement", "presidential_action.other",
            "fr.public_inspection", "fr.published.rule", "fr.published.proposed_rule", "fr.published.notice",
            "fr.published.presidential_document", "fr.published.other", "fr.correction",
            "wh.release", "wh.briefing_statement", "wh.fact_sheet", "wh.article", "wh.remarks", "wh.other",
            "court.opinion", "court.order_list", "court.argument", "court.grant"
          ]
        },
        { "type": "string", "pattern": "^(markup|briefing|speech|report)\\.[a-z][a-z_]*$" }
      ]
    },
    "status": { "enum": ["scheduled", "live", "ended", "postponed", "cancelled", "rescheduled", "corrected", "retracted", "published"] },
    "branch": { "enum": ["legislative", "executive", "judicial", "independent", "nongov"] },
    "body": { "type": "string", "pattern": "^(senate|house|white_house|scotus|fed|sec|federal_register|agency:[a-z0-9-]+)$" },
    "features": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^F([1-9]|1[0-2])$" }
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "official_text": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "importance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "reasons"],
      "properties": {
        "tier": { "enum": ["P0", "P1", "P2", "P3", "P4"] },
        "reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "times": {
      "type": "object",
      "additionalProperties": false,
      "required": ["occurred_at", "first_seen_at"],
      "properties": {
        "occurred_at": { "description": "When it happened in the world. null when the source gives no trustworthy time (never guessed).", "anyOf": [{ "$ref": "#/$defs/utc" }, { "type": "null" }] },
        "scheduled_for": { "anyOf": [{ "$ref": "#/$defs/utc" }, { "type": "null" }] },
        "source_published_at": { "anyOf": [{ "$ref": "#/$defs/utc" }, { "type": "null" }] },
        "first_seen_at": { "$ref": "#/$defs/utc" },
        "broadcast_at": { "anyOf": [{ "$ref": "#/$defs/utc" }, { "type": "null" }] }
      }
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "name"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "id": { "$ref": "#/$defs/key" },
          "name": { "type": "string", "minLength": 1 },
          "id_confidence": { "enum": ["authority", "curated", "inferred"] }
        }
      }
    },
    "related": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rel", "key"],
        "properties": { "rel": { "type": "string", "minLength": 1 }, "key": { "$ref": "#/$defs/key" } }
      }
    },
    "result": { "type": "object" },
    "member_votes_ref": { "type": "string" },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "url"],
        "properties": {
          "kind": { "enum": ["video_live", "video_archive", "audio", "pdf", "html"] },
          "url": { "$ref": "#/$defs/httpsUrl" },
          "is_live": { "type": "boolean" },
          "provider": { "type": "string" }
        }
      }
    },
    "transcript": { "anyOf": [{ "type": "null" }, { "type": "object" }] },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "url", "retrieved_at", "affiliation"],
        "properties": {
          "source_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
          "url": { "$ref": "#/$defs/httpsUrl" },
          "retrieved_at": { "$ref": "#/$defs/utc" },
          "license": { "type": "string" },
          "affiliation": { "$ref": "#/$defs/affiliation" }
        }
      }
    },
    "revision": { "type": "integer", "minimum": 1 },
    "supersedes": { "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^evt_[0-9a-f]{16}$" }] },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parser", "confidence"],
      "properties": {
        "parser": { "type": "string", "pattern": "^[a-z][a-z0-9_]*@\\d+\\.\\d+\\.\\d+$" },
        "confidence": { "enum": ["high", "inferred"] }
      }
    }
  }
}
