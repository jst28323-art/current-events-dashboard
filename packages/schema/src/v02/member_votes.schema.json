{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ced-member-votes-v0.1",
  "title": "CED member-vote side record v0.1",
  "description": "One record per roll call, never a feed event (docs/EVENT_MODEL.md v0.2, docs/design/P2.1.md §2.1). Built by a vote adapter from the same response as the vote.result event; served alone by the deferred votes API, so it carries its own identity, which validateMemberVotes checks against ref and vote_key.",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type", "record_version", "ref", "vote_key", "chamber", "congress", "session", "roll", "source", "members_map", "counts", "unresolved", "positions"],
  "$defs": {
    "count": { "type": "integer", "minimum": 0, "maximum": 1000 },
    "countOrNull": { "anyOf": [{ "$ref": "#/$defs/count" }, { "type": "null" }] },
    "utc": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,3})?Z$" },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["member_key", "id_confidence", "lis", "name", "name_source", "source_name", "party", "state", "role", "position", "vote_text", "pair"],
      "properties": {
        "member_key": { "type": "string", "pattern": "^(bioguide:[A-Z][0-9]{6}|lis:S[0-9]{3})$" },
        "id_confidence": { "enum": ["authority", "mapped", "unresolved"] },
        "lis": { "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^S[0-9]{3}$" }] },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "name_source": { "enum": ["map", "source"] },
        "source_name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "party": { "type": "string", "minLength": 1, "maxLength": 10 },
        "state": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "role": { "enum": ["legislator", "speaker", null] },
        "position": { "enum": ["yea", "nay", "present", "not_voting", "candidate"] },
        "vote_text": { "type": "string", "minLength": 1, "maxLength": 200 },
        "pair": { "anyOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 20 }] }
      }
    }
  },
  "properties": {
    "record_type": { "const": "member_votes" },
    "record_version": { "const": "0.1" },
    "ref": { "type": "string", "pattern": "^votes/(house|senate)/[0-9]{2,3}/[12]/[1-9][0-9]{0,4}\\.json$" },
    "vote_key": { "type": "string", "pattern": "^vote:(house|senate):[0-9]{2,3}:[12]:[1-9][0-9]{0,4}$" },
    "chamber": { "enum": ["house", "senate"] },
    "congress": { "type": "integer", "minimum": 1, "maximum": 999 },
    "session": { "enum": [1, 2] },
    "roll": { "type": "integer", "minimum": 1, "maximum": 99999 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "url", "retrieved_at", "parser"],
      "properties": {
        "source_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
        "url": { "type": "string", "pattern": "^https://[^\\s]+$", "maxLength": 2000 },
        "retrieved_at": { "$ref": "#/$defs/utc" },
        "parser": { "type": "string", "pattern": "^[a-z][a-z0-9_]*@\\d+\\.\\d+\\.\\d+$" }
      }
    },
    "members_map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "source_last_modified", "built_at"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "source_last_modified": { "type": ["string", "null"] },
        "built_at": { "$ref": "#/$defs/utc" }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["yea", "nay", "present", "not_voting"],
      "properties": {
        "yea": { "$ref": "#/$defs/countOrNull" },
        "nay": { "$ref": "#/$defs/countOrNull" },
        "present": { "$ref": "#/$defs/count" },
        "not_voting": { "$ref": "#/$defs/count" },
        "candidates": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "votes"], "properties": { "name": { "type": "string", "minLength": 1 }, "votes": { "$ref": "#/$defs/count" } } } }
      }
    },
    "unresolved": { "$ref": "#/$defs/count" },
    "positions": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/position" } }
  }
}
