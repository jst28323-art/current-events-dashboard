# gate runtime (local, head-pinned; never committed)
.gate/

# scratch space for probes, downloads, agent temp files
scratch/

# git worktrees made by Claude Code workflow agents (isolation: worktree); never part of the tree
.claude/worktrees/

# dependencies / builds
node_modules/
dist/
build/
.svelte-kit/
.astro/
.wrangler/
coverage/
playwright-report/
test-results/

# python (home-PC transcriber, later)
__pycache__/
*.pyc
.venv/

# secrets — never commit; use GitHub Actions secrets / Cloudflare secrets / a local .env
.env
.env.*
!.env.example
.dev.vars
*.pem
*.key

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# generated by `wrangler types` (typecheck regenerates it; tied to the wrangler version)
worker-configuration.d.ts
